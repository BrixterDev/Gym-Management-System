# Copy this file to .env.local and fill in values from
# Supabase Dashboard → Project Settings → API
#
# Only these two variables are exposed to the browser bundle.
# NEVER add the service role key / secret key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
